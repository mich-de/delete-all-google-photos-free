{
  "manifest_version": 3,
  "name": "Delete All Google Photos — Free & Unlimited",
  "short_name": "Delete All Photos",
  "version": "2.0.0",
  "description": "100% free & unlimited Google Photos bulk delete & storage cleaner: Library, Archive, Large Files, Blurry, Screenshots, Videos, Date & Favorite filters.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Delete All Google Photos — Free & Unlimited",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://photos.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://photos.google.com/*"
      ],
      "js": [
        "src/i18n.js",
        "src/selectors.js",
        "src/engine.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/overlay.css",
        "icons/*"
      ],
      "matches": [
        "https://photos.google.com/*"
      ]
    }
  ]
}
